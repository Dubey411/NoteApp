# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/noteapp?retryWrites=true&w=majority

# JWT Secret for authentication tokens
JWT_SECRET=your_super_secret_jwt_key_here

# (Optional) Google Gemini API Key for AI features (get free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port
PORT=5000
